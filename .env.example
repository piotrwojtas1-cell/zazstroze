# ─── Przykładowa konfiguracja środowiska ───────────────────────────────
# Skopiuj do `.env` i uzupełnij. NIE commituj pliku `.env`.
# Wartości sekretów wygeneruj poleceniem:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Połączenie z PostgreSQL (wymagane)
DATABASE_URL="postgresql://loyalty:CHANGE_ME@localhost:5432/loyalty?schema=public"

# Publiczny adres aplikacji (linki w e-mailach, kontrola nagłówka Origin)
APP_URL="http://localhost:3000"

# Klucz AES-256-GCM (32 bajty, base64) do szyfrowania sekretów integracji POS
ENCRYPTION_KEY=""

# Sekret HMAC do podpisywania dynamicznych kodów QR kart (min. 32 znaki)
CARD_QR_SECRET=""

# Pieprz do haszowania adresów IP w logach i limitach żądań (min. 32 znaki)
HASH_PEPPER=""

# Tryb demonstracyjny: kasa demo w panelu, dane logowania demo na ekranie logowania,
# e-maile zapisywane tylko w kolejce/logu. Na produkcji ustaw "false".
DEMO_MODE="true"

# Dostawca e-mail: "console" (zapis do tabeli EmailOutbox + log). Adapter SMTP/API — patrz README.
MAIL_PROVIDER="console"

# Ustaw "true" tylko gdy aplikacja działa za zaufanym reverse proxy ustawiającym X-Forwarded-For
TRUST_PROXY="false"
